# ==============================================================================
# NEXUS COMPUTER USE HARNESS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Providers (Configure at least one for live agent execution, or use 'mock' for offline testing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Provider & Model
NEXUS_DEFAULT_PROVIDER=anthropic
NEXUS_DEFAULT_MODEL=claude-3-7-sonnet-20250219

# Sandbox Execution Environment (docker | local)
NEXUS_SANDBOX_TYPE=docker
NEXUS_DOCKER_IMAGE=nexus-computer-use-sandbox:latest
NEXUS_DOCKER_CONTAINER_NAME=nexus_sandbox_runtime
NEXUS_DOCKER_DISPLAY=:99
NEXUS_DOCKER_VNC_PORT=5900
NEXUS_DOCKER_NOVNC_PORT=6080
NEXUS_SANDBOX_MEMORY_LIMIT=4g
NEXUS_SANDBOX_CPU_QUOTA=2.0

# Model Context Protocol (MCP) Configuration
NEXUS_MCP_AUTO_DISCOVERY=true
NEXUS_MCP_STORYTOLD_ENABLED=true
NEXUS_MCP_FILESYSTEM_ENABLED=true

# Guardrails & Budgets
NEXUS_MAX_STEPS=30
NEXUS_MAX_COST_USD=5.00
NEXUS_INJECTION_DEFENSE_LEVEL=strict
NEXUS_LOOP_DETECTION_WINDOW=4

# Logging & Telemetry
NEXUS_LOG_LEVEL=INFO
NEXUS_RECORD_RUNS=true
NEXUS_RUN_LOGS_DIR=./logs/runs
